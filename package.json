{
  "name": "@andestec/api-parametros",
  "version": "1.0.0",
  "description": "API Parámetros (NestJS) con persistencia sobre Redis (@andestec/persistencia-redis) y autenticación vía @andestec/api-dispositivos. Librería de servicios inyectables, sin controladores HTTP.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enternet-SA/APIParametros-NestJS.git"
  },
  "homepage": "https://github.com/Enternet-SA/APIParametros-NestJS#readme",
  "bugs": {
    "url": "https://github.com/Enternet-SA/APIParametros-NestJS/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@andestec/persistencia-redis": "git+https://github.com/Enternet-SA/persistencia-redis.git#main",
    "@andestec/api-dispositivos": "git+https://github.com/Enternet-SA/APIDispositivo-NestJS.git#main"
  },
  "peerDependencies": {
    "@nestjs/axios": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "axios": "^1.3.1",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "devDependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "axios": "^1.7.0",
    "jest": "^30.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
